OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2048
OPENAI_TIMEOUT_MS=30000
SHOPIFY_API_KEY=your-shopify-api-key-here
SHOPIFY_API_SECRET=your-shopify-api-secret-here
SHOPIFY_REDIRECT_URI=https://your-domain.com/api/auth/shopify/callback

# 数据库（Postgres；本地可用 docker compose up -d 起 pg，见 docker-compose.yml）
DATABASE_URL=postgres://smart_crossborder:smart_crossborder@localhost:5432/smart_crossborder
# 连接池上限（默认 10）
PG_POOL_SIZE=10

# 可选 Redis（多实例部署：登录限流共享状态 + 任务取消广播；不配置则自动降级进程内版本）
# REDIS_URL=redis://localhost:6379

# 开发环境示例数据；设为 false 可关闭
SEED_DEMO_DATA=true

# 认证：会话 Cookie 为唯一身份来源；不再支持 query/body/header 的 userId 传参。

# 会话/系统维护接口鉴权密钥；不配置则维护接口恒 403（生产建议配置并挂外部 cron 定时清理会话）
# MAINTENANCE_SECRET=change-me-random
