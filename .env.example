OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2048
OPENAI_TIMEOUT_MS=30000
SHOPIFY_API_KEY=your-shopify-api-key-here
SHOPIFY_API_SECRET=your-shopify-api-secret-here
SHOPIFY_REDIRECT_URI=https://your-domain.com/api/auth/shopify/callback

# 开发环境示例数据；设为 false 可关闭
SEED_DEMO_DATA=true
# 兼容旧 userId 传参，仅本地调试；生产必须为 0
AUTH_LEGACY_COMPAT=0
