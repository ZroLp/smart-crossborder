OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2048
OPENAI_TIMEOUT_MS=30000
SHOPIFY_API_KEY=your-shopify-api-key-here
SHOPIFY_API_SECRET=your-shopify-api-secret-here
SHOPIFY_REDIRECT_URI=https://your-domain.com/api/auth/shopify/callback

# 数据库（Postgres；本地可用 docker compose up -d 起 pg，见 docker-compose.yml）
DATABASE_URL=postgres://smart_crossborder:smart_crossborder@localhost:5432/smart_crossborder
# 连接池上限（默认 10）
PG_POOL_SIZE=10

# 可选 Redis（多实例部署：登录限流共享状态 + 任务取消广播；不配置则自动降级进程内版本）
# REDIS_URL=redis://localhost:6379

# 开发环境示例数据；设为 false 可关闭
SEED_DEMO_DATA=true

# 认证：会话 Cookie 为唯一身份来源；不再支持 query/body/header 的 userId 传参。

# 会话/系统维护接口鉴权密钥；不配置则维护接口恒 403（生产建议配置并挂外部 cron 定时清理会话）
# MAINTENANCE_SECRET=change-me-random

# ---- P6 支付 / Webhook ----
# 支付 Webhook HMAC-SHA256 签名密钥（P6-04；生产必配，缺失时 /api/webhooks/payment 恒 503 fail-closed）
PAYMENT_WEBHOOK_SECRET=your-payment-webhook-secret-here
# 强制走 3DS 验证流的 mock 开关（金额 ≥¥500 天然触发，无需配置）
# PAYMENT_MOCK_3DS=1

# ---- P6 短信双供应商（P6-02；凭据缺失自动降级 mock，非生产回显 devCode）----
# 供应商选择：tencent（默认）/ aliyun
# SMS_PROVIDER=tencent
# 腾讯云 SMS（TC3-HMAC-SHA256 签名）
# SMS_TENCENT_SECRET_ID=
# SMS_TENCENT_SECRET_KEY=
# SMS_TENCENT_SDK_APP_ID=
# SMS_TENCENT_SIGN_NAME=
# SMS_TENCENT_TEMPLATE_ID=
# 阿里云 SMS（RPC HMAC-SHA1 签名）
# SMS_ALIYUN_ACCESS_KEY_ID=
# SMS_ALIYUN_ACCESS_KEY_SECRET=
# SMS_ALIYUN_SIGN_NAME=
# SMS_ALIYUN_TEMPLATE_CODE=

# ---- P6 邮箱验证（P6-01；配置后走真实投递，否则非生产回显 devCode）----
# EMAIL_PROVIDER=

# ---- P10 可观测与告警（P10-02）----
# 告警 Webhook（scripts/monitor-alerts.sh 1min 轮询触发时 POST 到此地址）
# ALERT_WEBHOOK_URL=
# 告警阈值：队列积压 / worker 停滞秒数 / 轮询间隔
# QUEUE_ALERT_DEPTH=100
# STALE_TASK_SECONDS=300
# ALERT_INTERVAL_SECONDS=60

# ---- P10 生产启动开关 ----
# 密钥 fail fast（默认生产开启；SECRET_FAIL_FAST=false 可降级为过渡期警告）
# SECRET_FAIL_FAST=true
# 多实例自动 worker（每实例启动自动拉起 TaskQueueWorker；只跑 API 不跑任务时置 false）
# WORKER_AUTO_START=true
